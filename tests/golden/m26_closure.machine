  system Advance {
    param config: read M26Closure.Config core-id 0x0000000000000005
    param counter: mut M26Closure.Counter core-id 0x0000000000000006
    param moving: query
      mut M26Closure.Position core-id 0x0000000000000000
      read M26Closure.Velocity core-id 0x0000000000000001
      read M26Closure.Enemy core-id 0x0000000000000003
      exclude M26Closure.Frozen core-id 0x0000000000000004
    let mut pass: i32 = i32.const 0
    let mut gate: bool = config.enabled
    while i32.lt pass, config.step {
      if bool.and gate, i32.lt pass, i32.const 2 {
        for moving {
          bind position: mut M26Closure.Position core-id 0x0000000000000000
          bind velocity: read M26Closure.Velocity core-id 0x0000000000000001
          bind _: read M26Closure.Enemy core-id 0x0000000000000003
          assign position.x, i32.add position.x, i32.shl velocity.dx, i32.and pass, i32.const 31
          assign position.weight, f32.add position.weight, f32.mul velocity.factor, config.scale
          assign position.active, eq position.active, bool.const true
          assign counter.value, i32.add counter.value, i32.const 1
        }
      } else {
        assign counter.value, i32.add counter.value, i32.const 10
      }
      assign pass, i32.add pass, i32.const 1
      assign gate, bool.or bool.not gate, eq pass, config.step
    }
    for moving {
      bind position: mut M26Closure.Position core-id 0x0000000000000000
      bind velocity: read M26Closure.Velocity core-id 0x0000000000000001
      bind _: read M26Closure.Enemy core-id 0x0000000000000003
      if f32.ge position.weight, velocity.factor {
        add_assign position.x, i32.and counter.value, i32.const 3
      } else {
        assign position.x, i32.sub position.x, i32.const 1
      }
    }
  }

  system Normalize {
    param first: read M26Closure.Counter core-id 0x0000000000000006
    param second: read M26Closure.Counter core-id 0x0000000000000006
    param candidates: query
      mut M26Closure.Position core-id 0x0000000000000000
      exclude M26Closure.Enemy core-id 0x0000000000000003
    let mut visits: i32 = i32.const 0
    for candidates {
      bind position: mut M26Closure.Position core-id 0x0000000000000000
      block {
        assign position.x, i32.xor position.x, i32.or first.value, second.value
        assign position.weight, f32.div f32.neg position.weight, f32.bits 0x40000000
        assign position.active, bool.and position.active, bool.const true
        assign visits, i32.add visits, i32.const 1
      }
    }
    if eq visits, i32.const 0 {
      assign visits, i32.not visits
    } else {
      assign visits, i32.rem visits, i32.const 4
    }
  }

